# Copy to .env and fill in. .env is gitignored.

# OpenRouter key for the naive baseline only (OpenRouter is not EU-compliant hosting for the submission)
OPENROUTER_API_KEY=

# Open-weight models on OpenRouter. Mistral Small 3.2 (24B, Apache-2.0) reads both text and page images.
NAIVE_CLASSIFY_MODEL=mistralai/mistral-small-3.2-24b-instruct
NAIVE_EXTRACT_MODEL=mistralai/mistral-small-3.2-24b-instruct

# Model fallback of the main program (config/pipeline.yaml -> llm.api_key_env). ARK Labs, EU-hosted.
ARK_API_KEY=

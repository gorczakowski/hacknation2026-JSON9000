# Copy to research/.env (gitignored). Used only by the dev experiments in research/ (naive baselines, benchmarks).
# OpenRouter is a US service: fine for experiments on the synthetic training data, NOT used by the solution.
OPENROUTER_API_KEY=
NAIVE_CLASSIFY_MODEL=mistralai/mistral-small-3.2-24b-instruct
NAIVE_EXTRACT_MODEL=mistralai/mistral-small-3.2-24b-instruct
# For the ARK runs of the experiments (optional), the solution's key from the root .env can be reused:
ARK_API_KEY=
